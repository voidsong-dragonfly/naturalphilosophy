{
  "priority": 2001,
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "naturalphilosophy:biome",
        "biome_is": "#naturalphilosophy:snowy_caves"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "add_surface_depth": true,
          "offset": 2,
          "secondary_depth_range": 0,
          "surface_type": "floor"
        },
        "then_run": {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:water",
            "add_stone_depth": false,
            "offset": -1,
            "surface_depth_multiplier": 0
          },
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "naturalphilosophy:heightmap_depth",
                  "depth": 16
                },
                "then_run": {
                  "type": "minecraft:block",
                  "result_state": {
                    "Name": "minecraft:stone"
                  }
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "naturalphilosophy:heightmap_depth",
                  "depth": 12
                },
                "then_run": {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:not",
                        "invert": {
                          "type": "minecraft:stone_depth",
                          "add_surface_depth": false,
                          "offset": 0,
                          "secondary_depth_range": 0,
                          "surface_type": "floor"
                        }
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:stone"
                        }
                      }
                    },
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "max_threshold": 1E308,
                        "min_threshold": -0.5,
                        "noise": "naturalphilosophy:surface_randomness"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:stone"
                        }
                      }
                    },
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "max_threshold": 1E308,
                        "min_threshold": -1.0,
                        "noise": "naturalphilosophy:surface_randomness"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:gravel"
                        }
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": {
                        "Name": "minecraft:snow_block"
                      }
                    }
                  ]
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "naturalphilosophy:heightmap_depth",
                  "depth": 6
                },
                "then_run": {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:not",
                        "invert": {
                          "type": "minecraft:stone_depth",
                          "add_surface_depth": true,
                          "offset": -2,
                          "secondary_depth_range": 0,
                          "surface_type": "floor"
                        }
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:stone"
                        }
                      }
                    },
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "max_threshold": 1E308,
                        "min_threshold": 0.125,
                        "noise": "naturalphilosophy:surface_randomness"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:stone"
                        }
                      }
                    },
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "max_threshold": 1E308,
                        "min_threshold": -0.1875,
                        "noise": "naturalphilosophy:surface_randomness"
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": {
                          "Name": "minecraft:gravel"
                        }
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": {
                        "Name": "minecraft:snow_block"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}