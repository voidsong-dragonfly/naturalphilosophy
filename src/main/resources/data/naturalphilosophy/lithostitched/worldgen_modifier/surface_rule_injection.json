{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "lithostitched:reference",
          "rules": "naturalphilosophy:abstract/cave_entrances"
        },
        {
          "type": "lithostitched:reference",
          "rules": "naturalphilosophy:abstract/cliffs"
        },
        {
          "type": "naturalphilosophy:bilayer_fill",
          "top_layer": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:abstract/land_surface"
          },
          "sublayer": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:abstract/land_sublayer"
          }
        },
        {
          "type": "naturalphilosophy:bilayer_fill",
          "land": false,
          "top_layer": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:abstract/aquatic_surface"
          },
          "sublayer": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:abstract/aquatic_sublayer"
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:biome",
            "biome_is": [ "minecraft:mushroom_fields" ]
          },
          "then_run": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:water_supertype/mushroom_fields"
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:biome",
            "biome_is": [ "minecraft:ice_spikes" ]
          },
          "then_run": {
            "type": "lithostitched:reference",
            "rules": "naturalphilosophy:plains_supertype/ice_spikes"
          }
        }
      ]
    }
  }
}
