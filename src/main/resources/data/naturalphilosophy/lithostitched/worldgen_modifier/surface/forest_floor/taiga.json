{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:taiga"
        ]
      },
      "then_run": {
        "type": "naturalphilosophy:bilayer_fill",
        "top_layer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "cascade": true,
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:grass_block"
            }
          },
          "lower_noise_thresholds": [
             0.275,
             0.25,
             0.125,
             0.0,
            -0.5
          ],
          "ruleset": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "max_threshold": 1E308,
                "min_threshold": 0.25,
                "noise": "minecraft:surface_swamp"
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:moss_block"
                }
              }
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:moss_block"
              },
              "lower_random_thresholds": [ 0.25 ],
              "state_set": [{
                "Name": "minecraft:podzol"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:moss_block"
              },
              "lower_random_thresholds": [ 0.4375 ],
              "state_set": [{
                "Name": "minecraft:podzol"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:grass_block"
              },
              "lower_random_thresholds": [
                0.90,
                0.25
              ],
              "state_set": [
                {
                  "Name": "minecraft:rooted_dirt"
                },
                {
                  "Name": "minecraft:podzol"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:grass_block"
              },
              "lower_random_thresholds": [ 0.5 ],
              "state_set": [{
                "Name": "minecraft:podzol"
              }]
            }
          ]
        },
        "sublayer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:dirt"
            }
          },
          "lower_noise_thresholds": [
             0.125,
             0.0,
            -0.5
          ],
          "ruleset": [
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:coarse_dirt"
              },
              "lower_random_thresholds": [ 0.925 ],
              "state_set": [{
                "Name": "minecraft:rooted_dirt"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:dirt"
              },
              "lower_random_thresholds": [
                0.625,
                0.5
              ],
              "state_set": [
                {
                  "Name": "minecraft:rooted_dirt"
                },
                {
                  "Name": "minecraft:coarse_dirt"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:dirt"
              },
              "lower_random_thresholds": [
                0.925,
                0.90
              ],
              "state_set": [
                {
                  "Name": "minecraft:rooted_dirt"
                },
                {
                  "Name": "minecraft:coarse_dirt"
                }
              ]
            }
          ]
        }
      }
    }
  }
}