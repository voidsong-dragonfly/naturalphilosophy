{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:warm_ocean"
        ]
      },
      "then_run": {
        "type": "naturalphilosophy:bilayer_fill",
        "land": false,
        "top_layer": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:not",
                "invert": {
                  "type": "minecraft:vertical_gradient",
                  "random_name": "reef",
                  "true_at_and_below": {
                    "absolute": 25
                  },
                  "false_at_and_above": {
                    "absolute": 40
                  }
                }
              },
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:noise_threshold",
                  "max_threshold": 0.075,
                  "min_threshold": -0.075,
                  "noise": "naturalphilosophy:coral_reefs"
                },
                "then_run": {
                  "type": "naturalphilosophy:random_threshold_selector",
                  "random_name": "surface_randomness",
                  "default_state": {
                    "Name": "minecraft:sand"
                  },
                  "lower_random_thresholds": [
                    0.30,
                    0.10
                  ],
                  "state_set": [
                    {
                      "Name": "minecraft:calcite"
                    },
                    {
                      "Name": "minecraft:sandstone"
                    }
                  ]
                }
              }
            },
            {
              "type": "naturalphilosophy:noise_threshold_selector",
              "noise": "minecraft:surface",
              "default_rule": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:mud"
                }
              },
              "lower_noise_thresholds": [
                 0.5,
                 0.25,
                -0.375,
                -0.4375,
                -0.5
              ],
              "ruleset": [
                {
                  "type": "naturalphilosophy:random_threshold_selector",
                  "random_name": "surface_randomness",
                  "default_state": {
                    "Name": "minecraft:sand"
                  },
                  "lower_random_thresholds": [ 0.50 ],
                  "state_set": [{
                    "Name": "minecraft:sandstone"
                  }]
                },
                {
                  "type": "naturalphilosophy:random_threshold_selector",
                  "random_name": "surface_randomness",
                  "default_state": {
                    "Name": "minecraft:sand"
                  },
                  "lower_random_thresholds": [ 0.65 ],
                  "state_set": [{
                    "Name": "minecraft:sandstone"
                  }]
                },
                {
                  "type": "minecraft:block",
                  "result_state": {
                    "Name": "minecraft:sand"
                  }
                },
                {
                  "type": "naturalphilosophy:random_threshold_selector",
                  "random_name": "surface_randomness",
                  "default_state": {
                    "Name": "minecraft:mud"
                  },
                  "lower_random_thresholds": [ 0.5 ],
                  "state_set": [{
                    "Name": "minecraft:sand"
                  }]
                },
                {
                  "type": "naturalphilosophy:random_threshold_selector",
                  "random_name": "surface_randomness",
                  "default_state": {
                    "Name": "minecraft:mud"
                  },
                  "lower_random_thresholds": [ 0.85 ],
                  "state_set": [{
                    "Name": "minecraft:sand"
                  }]
                }
              ]
            }
          ]
        },
        "sublayer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:sand"
            }
          },
          "lower_noise_thresholds": [
            -0.4375,
            -0.5
          ],
          "ruleset": [
            {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:sandstone"
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:not",
                "invert": {
                  "type": "minecraft:stone_depth",
                  "add_surface_depth": false,
                  "offset": 2,
                  "secondary_depth_range": 0,
                  "surface_type": "floor"
                }
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:sandstone"
                }
              }
            }
          ]
        }
      }
    }
  }
}
