{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:stony_shore",
          "minecraft:ocean",
          "minecraft:deep_ocean",
          "minecraft:cold_ocean",
          "minecraft:deep_cold_ocean",
          "minecraft:frozen_ocean",
          "minecraft:deep_frozen_ocean"
        ]
      },
      "then_run": {
        "type": "naturalphilosophy:bilayer_fill",
        "land": false,
        "top_layer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "naturalphilosophy:random_threshold_selector",
            "random_name": "surface_randomness",
            "default_state": {
              "Name": "minecraft:mud"
            },
            "lower_random_thresholds": [ 0.95 ],
            "state_set": [{
              "Name": "minecraft:gravel"
            }]
          },
          "lower_noise_thresholds": [
             0.5,
             0.25,
            -0.375,
            -0.4375,
            -0.5
          ],
          "ruleset": [
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:gravel"
              },
              "lower_random_thresholds": [
                0.75,
                0.50
              ],
              "state_set": [
                {
                  "Name": "minecraft:stone"
                },
                {
                  "Name": "minecraft:cobblestone"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:gravel"
              },
              "lower_random_thresholds": [
                0.85,
                0.65
              ],
              "state_set": [
                {
                  "Name": "minecraft:stone"
                },
                {
                  "Name": "minecraft:cobblestone"
                }
              ]
            },
            {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:gravel"
              }
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:mud"
              },
              "lower_random_thresholds": [ 0.5 ],
              "state_set": [{
                "Name": "minecraft:gravel"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:mud"
              },
              "lower_random_thresholds": [ 0.85 ],
              "state_set": [{
                "Name": "minecraft:gravel"
              }]
            }
          ]
        },
        "sublayer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:gravel"
            }
          },
          "lower_noise_thresholds": [
            -0.4375,
            -0.5
          ],
          "ruleset": [
            {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:stone"
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:not",
                "invert": {
                  "type": "minecraft:stone_depth",
                  "add_surface_depth": false,
                  "offset": 2,
                  "secondary_depth_range": 0,
                  "surface_type": "floor"
                }
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:stone"
                }
              }
            }
          ]
        }
      }
    }
  }
}