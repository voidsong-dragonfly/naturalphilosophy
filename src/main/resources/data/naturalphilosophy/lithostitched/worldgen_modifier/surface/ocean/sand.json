{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:lukewarm_ocean",
          "minecraft:deep_lukewarm_ocean"
        ]
      },
      "then_run": {
        "type": "naturalphilosophy:bilayer_fill",
        "land": false,
        "top_layer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:mud"
            }
          },
          "lower_noise_thresholds": [
             0.625,
             0.375,
            -0.25,
            -0.3125,
            -0.4375
          ],
          "ruleset": [
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:sand"
              },
              "lower_random_thresholds": [ 0.50 ],
              "state_set": [{
                "Name": "minecraft:gravel"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:sand"
              },
              "lower_random_thresholds": [ 0.65 ],
              "state_set": [{
                "Name": "minecraft:gravel"
              }]
            },
            {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:sand"
              }
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:mud"
              },
              "lower_random_thresholds": [ 0.5 ],
              "state_set": [{
                "Name": "minecraft:sand"
              }]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:mud"
              },
              "lower_random_thresholds": [ 0.85 ],
              "state_set": [{
                "Name": "minecraft:sand"
              }]
            }
          ]
        },
        "sublayer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:mud"
            }
          },
          "lower_noise_thresholds": [
            -0.3125,
            -0.4375
          ],
          "ruleset": [
            {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:stone"
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:not",
                "invert": {
                  "type": "minecraft:stone_depth",
                  "add_surface_depth": false,
                  "offset": 2,
                  "secondary_depth_range": 0,
                  "surface_type": "floor"
                }
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:stone"
                }
              }
            }
          ]
        }
      }
    }
  }
}