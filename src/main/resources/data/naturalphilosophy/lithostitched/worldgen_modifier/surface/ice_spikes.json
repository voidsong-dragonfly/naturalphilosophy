{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:ice_spikes"
        ]
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:not",
          "invert": {
            "type": "naturalphilosophy:underwater"
          }
        },
        "then_run": {
          "type": "naturalphilosophy:stone_depth_threshold_selector",
          "default_rule": {
            "type": "naturalphilosophy:random_threshold_selector",
            "random_name": "surface_randomness",
            "default_state": {
              "Name": "minecraft:packed_ice"
            },
            "lower_random_thresholds": [
              0.55,
              0.40
            ],
            "state_set": [
              {
                "Name": "minecraft:gravel"
              },
              {
                "Name": "minecraft:blue_ice"
              }
            ]
          },
          "ruleset": [
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:snow_block"
              },
              "lower_random_thresholds": [
                0.95
              ],
              "state_set": [
                {
                  "Name": "minecraft:ice"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:snow_block"
              },
              "lower_random_thresholds": [
                0.80
              ],
              "state_set": [
                {
                  "Name": "minecraft:packed_ice"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:snow_block"
              },
              "lower_random_thresholds": [
                0.90,
                0.70
              ],
              "state_set": [
                {
                  "Name": "minecraft:gravel"
                },
                {
                  "Name": "minecraft:packed_ice"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:packed_ice"
              },
              "lower_random_thresholds": [
                0.55,
                0.40
              ],
              "state_set": [
                {
                  "Name": "minecraft:gravel"
                },
                {
                  "Name": "minecraft:blue_ice"
                }
              ]
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "max_threshold": 1E308,
                "min_threshold": 0.5,
                "noise": "minecraft:surface_swamp"
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {
                  "Name": "minecraft:stone"
                }
              }
            }
          ]
        }
      }
    }
  }
}