{
  "type": "lithostitched:add_surface_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:above_preliminary_surface"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:biome",
        "biome_is": [
          "minecraft:cherry_grove"
        ]
      },
      "then_run": {
        "type": "naturalphilosophy:bilayer_fill",
        "top_layer":  {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:grass_block",
            "Properties": {
              "snowy": "false"
            }
          }
        },
        "sublayer": {
          "type": "naturalphilosophy:noise_threshold_selector",
          "noise": "minecraft:surface",
          "default_rule": {
            "type": "naturalphilosophy:random_threshold_selector",
            "random_name": "surface_randomness",
            "default_state": {
              "Name": "minecraft:dirt"
            },
            "lower_random_thresholds": [ 0.10 ],
            "state_set": [{
              "Name": "minecraft:coarse_dirt"
            }]
          },
          "lower_noise_thresholds": [
            -0.25,
            -0.3125
          ],
          "ruleset": [
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:dirt"
              },
              "lower_random_thresholds": [
                0.325,
                0.30
              ],
              "state_set": [
                {
                  "Name": "minecraft:rooted_dirt"
                },
                {
                  "Name": "minecraft:coarse_dirt"
                }
              ]
            },
            {
              "type": "naturalphilosophy:random_threshold_selector",
              "random_name": "surface_randomness",
              "default_state": {
                "Name": "minecraft:dirt"
              },
              "lower_random_thresholds": [
                0.70,
                0.20
              ],
              "state_set": [
                {
                  "Name": "minecraft:rooted_dirt"
                },
                {
                  "Name": "minecraft:coarse_dirt"
                }
              ]
            }
          ]
        }
      }
    }
  }
}