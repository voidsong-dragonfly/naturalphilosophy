{
  "type": "minecraft:condition",
  "if_true": {
    "type": "naturalphilosophy:land_top_layer"
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "naturalphilosophy:biome",
      "biome_is": "#naturalphilosophy:forest_tracks"
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "max_threshold": 0.0125,
        "min_threshold": -0.0125,
        "noise": "naturalphilosophy:forest_paths"
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:not",
          "invert": {
            "type": "minecraft:noise_threshold",
            "max_threshold": 1E308,
            "min_threshold": 0.375,
            "noise": "minecraft:surface_swamp"
          }
        },
        "then_run": {
          "type": "naturalphilosophy:random_threshold_selector",
          "random_name": "forest_path_randomness",
          "default_state": {
            "Name": "minecraft:dirt_path"
          },
          "lower_random_thresholds": [
            0.95,
            0.30,
            0.20
          ],
          "state_set": [
            {
              "Name": "minecraft:gravel"
            },
            {
              "Name": "minecraft:coarse_dirt"
            },
            {
              "Name": "minecraft:rooted_dirt"
            }
          ]
        }
      }
    }
  }
}



