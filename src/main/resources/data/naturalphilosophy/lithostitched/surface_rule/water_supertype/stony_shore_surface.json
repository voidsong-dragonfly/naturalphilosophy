{
  "type": "naturalphilosophy:height_threshold_selector",
  "add_stone_depth": true,
  "surface_depth_multiplier": 1,
  "cascade": true,
  "default_rule":  {
    "type": "lithostitched:reference",
    "rules": "naturalphilosophy:blocks/gravel"
  },
  "lower_height_thresholds": [
    65,
    62
  ],
  "ruleset": [
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "naturalphilosophy:shallow_slope"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "max_threshold": 0.10,
              "min_threshold": -0.15,
              "noise": "naturalphilosophy:surface_small"
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:stone"
              }
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "lithostitched:sample_density",
              "density_function": "naturalphilosophy:rocks",
              "max_inclusive":  0.125,
              "min_inclusive": -0.125
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:stone"
              }
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "max_threshold": 0.25,
              "min_threshold": -0.35,
              "noise": "naturalphilosophy:surface_small"
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": {
                "Name": "minecraft:gravel"
              }
            }
          },
          {
            "type": "minecraft:block",
            "result_state": {
              "Name": "minecraft:grass_block"
            }
          }
        ]
      }
    },
    {
      "type": "minecraft:block",
      "result_state": {
        "Name": "minecraft:stone"
      }
    }
  ]
}