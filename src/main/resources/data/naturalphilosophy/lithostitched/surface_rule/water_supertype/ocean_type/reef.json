{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:not",
    "invert": {
      "type": "minecraft:vertical_gradient",
      "random_name": "reef",
      "true_at_and_below": {
        "absolute": 25
      },
      "false_at_and_above": {
        "absolute": 40
      }
    }
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:noise_threshold",
      "max_threshold": 0.075,
      "min_threshold": -0.075,
      "noise": "naturalphilosophy:coral_reef"
    },
    "then_run": {
      "type": "minecraft:block",
      "result_state": {
        "Name": "minecraft:calcite"
      }
    }
  }
}