        {
          "model": "naturalphilosophy:block/giant_bamboo/stalk_thick_2"
        },
        {
          "model": "naturalphilosophy:block/giant_bamboo/stalk_thick_3"
        },
        {
          "model": "naturalphilosophy:block/giant_bamboo/stalk_thick_4"
        }
      ],
      "when": {
        "age": "1"
      }
    },
    {
